{
  "name": "course-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An AI course studio: turn a brief or a pile of source material into a complete, publishable digital course — outline, lesson scripts, slides, quizzes, and an LMS-ready package.",
  "bin": {
    "course-forge": "server/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test",
    "demo": "node server/cli.js demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
