# Etsy Open API v3 application keystring.
# Register an app at https://www.etsy.com/developers/register and copy the
# keystring from the app's page. Free tier: 10 requests/second, 10,000/day —
# a 60-keyword daily scan plus its 20 long-tail lookups uses 80.
ETSY_API_KEY=

# Primary buyer market. Drives both the Google Trends geo and the seasonal
# calendar (e.g. UK Mothering Sunday vs US Mother's Day).
ETSY_TRENDS_GEO=US

# Optional overrides. Defaults are ./data and ./reports inside this project.
# ETSY_TRENDS_DATA_DIR=
# ETSY_TRENDS_REPORT_DIR=
