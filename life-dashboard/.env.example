# Where the dashboard keeps its data. Defaults to ./data
# LIFE_DASHBOARD_DATA_DIR=/home/you/.life-dashboard

# Port the local server listens on. Defaults to 5175
# PORT=5175

# Open Banking (optional — the dashboard works fully without it).
# Register a client at https://console.truelayer.com, then:
# TRUELAYER_CLIENT_ID=your-client-id
# TRUELAYER_CLIENT_SECRET=your-client-secret
# TRUELAYER_ENV=sandbox            # sandbox | live
# TRUELAYER_REDIRECT_URI=http://localhost:5175/api/banking/callback
