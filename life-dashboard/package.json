{
  "name": "life-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first dashboard for one life: today's plan, what is coming up, what leaves the account before payday, and a news reel on the people, companies and objectives you are tracking.",
  "bin": {
    "life": "server/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test",
    "brief": "node server/cli.js brief",
    "demo": "node server/cli.js demo",
    "doctor": "node server/cli.js doctor"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
